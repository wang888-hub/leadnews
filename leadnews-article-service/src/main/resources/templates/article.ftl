<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${article.title?html}</title></head><body><article><h1>${article.title?html}</h1><p>${article.authorName?html} · ${article.channelName?html} · ${article.publishTime!}</p><#if article.summary??><p>${article.summary?html}</p></#if><#list content as item><#if item.type()=="text"><p>${item.value()?html}</p><#elseif item.type()=="image"><img src="${item.value()?html}" alt="文章图片" loading="lazy"></#if></#list></article></body></html>
