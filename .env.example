# Local development defaults only. Copy this file to .env and change passwords.
MYSQL_ROOT_PASSWORD=leadnews_mysql_dev
REDIS_PASSWORD=leadnews_redis_dev
NACOS_USERNAME=nacos
NACOS_PASSWORD=leadnews_nacos_dev
NACOS_AUTH_TOKEN=bGVhZG5ld3MtbG9jYWwtZGV2ZWxvcG1lbnQtdG9rZW4tY2hhbmdlLW1l
NACOS_AUTH_IDENTITY_KEY=leadnews-server-key
NACOS_AUTH_IDENTITY_VALUE=leadnews-server-value
MINIO_ROOT_USER=leadnews
MINIO_ROOT_PASSWORD=leadnews_minio_dev
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=leadnews
MINIO_SECRET_KEY=leadnews_minio_dev
MINIO_BUCKET=leadnews
PUBLISH_MAX_RETRIES=3
PUBLISH_TIMEOUT=PT5M
SCHEDULE_PRELOAD_WINDOW=PT30S
SCHEDULE_SCAN_INTERVAL=PT1S
SCHEDULE_RETRY_DELAY=PT10S
SCHEDULE_MAX_RETRIES=3
XXL_JOB_ENABLED=false
XXL_JOB_ACCESS_TOKEN=replace-with-local-xxl-job-token
XXL_JOB_EXECUTOR_LOG_PATH=./logs/xxl-job
BEHAVIOR_TOPIC=leadnews.behavior.events
BEHAVIOR_DLT_TOPIC=leadnews.behavior.events.DLT
BEHAVIOR_PENDING_RETRY_MILLIS=5000
BEHAVIOR_VIEW_FLUSH_MILLIS=1000
JWT_SECRET=replace-with-at-least-32-random-characters
# Set API-KEY only in the Windows process/user environment; do not put it in this file.
AI_SUMMARY_ENABLED=true
AI_SUMMARY_MIN_LENGTH=80
AI_SUMMARY_MAX_LENGTH=160
AI_SUMMARY_MAX_RETRIES=3
AI_SUMMARY_RUNNING_TIMEOUT=PT2M
AI_CONTINUATION_MIN_TARGET_LENGTH=100
AI_CONTINUATION_MAX_TARGET_LENGTH=1000
AI_CONTINUATION_MAX_INPUT_LENGTH=20000
AI_MODEL=qwen3.8-max
AUDIT_TOPIC=leadnews.wemedia.audit
AUDIT_DLT_TOPIC=leadnews.wemedia.audit.DLT
AUDIT_AUTO_PASS_THRESHOLD=0.85
AUDIT_AUTO_REJECT_THRESHOLD=0.90
AUDIT_AI_MAX_IMAGES=5
AI_SAFE_TEXT_LIMIT=20000
